// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-docker-compose
{
	"name": "lma-rma-ros2-devcontainer",
	"dockerComposeFile": [
		"../compose.yaml",
		"compose.yaml"
	],
	"containerEnv": {
		"SHELL": "/bin/bash" // Starting shell
	},
	"service": "lma_rma_environment_ros2_jazzy",
	"workspaceFolder": "/persistent",
	// Extensions for
	// * Cpp
	// * Cmake
	// * Python
	// * QoL
	"customizations": {
		"vscode": {
			"settings": {
				"C_Cpp.intelliSenseEngine": "default"
			},
			"extensions": [
				// Cpp
				"jeff-hykin.better-cpp-syntax", // Just niceties.
				"ms-vscode.cpptools", // This is what the ROS2 ecosystem expects, even if clangd would have been a better option.
				// Cmake
				"josetr.cmake-language-support-vscode", // Adds better completion for commands in CMAKE.
				"ms-dotnettools.vscode-dotnet-runtime", // Dependency of the ms cmake extension.
				"ms-vscode.cmake-tools", // This is somewhat bare bones even if its the "oficial" one.
				// Python
				"charliermarsh.ruff", // Our defined Python formatter.
				"ms-python.python",
				"ms-python.vscode-pylance",
				// ROS2
				"nonanonno.vscode-ros2",
				"Ranch-Hand-Robotics.rde-ros-2",
				"Ranch-Hand-Robotics.urdf-editor",
				// QoL
				"aaron-bond.better-comments",
				"usernamehw.errorlens"
			]
		}
	}
}