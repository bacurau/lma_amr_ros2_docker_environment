DOCKER_USER=amr

# For forwarding the X11 server
DISPLAY=${DISPLAY}

# Allows a persistent shell history
HISTFILE=/persistent/.bash_history

# This is connected to the 'runtime: nvidia' command found in docker compose
# More information about this can be found at https://github.com/gazebosim/gz-sim/issues/3024#event-19275228460, and the part about envs
# at https://forums.developer.nvidia.com/t/nvidia-docker-runtime-does-not-seem-to-work-with-docker-compose/307879/2
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all
